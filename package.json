{
  "name": "skill-bridge",
  "version": "0.1.0",
  "description": "Bidirectional CLI for migrating skills between Claude Code and Codex.",
  "type": "module",
  "license": "MIT",
  "author": "Estifie",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "skill-bridge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "bun src/index.ts",
    "prepare": "bun run build"
  },
  "keywords": [
    "claude-code",
    "codex",
    "skills",
    "skill-bridge",
    "cli",
    "migration",
    "typescript"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estifie/skill-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/estifie/skill-bridge/issues"
  },
  "homepage": "https://github.com/estifie/skill-bridge#readme"
}
